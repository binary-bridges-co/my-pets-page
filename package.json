{
  "name": "my-pets-page",
  "private": true,
  "type": "module",
  "description": "The My Pets public page: a static site that reads a pet's public card from the app's iCloud public database (docs/DESIGN.md).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:spec": "scripts/check-spec-source.sh",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run check:vendor && npm run typecheck && node scripts/build.mjs",
    "test:unit": "node scripts/build-tests.mjs && node --test --test-reporter=spec build/test/*.test.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "test": "npm run test:unit",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "check:headers": "node scripts/check-headers.mjs",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.140.0"
  }
}
