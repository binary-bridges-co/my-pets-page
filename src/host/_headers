# Response headers (docs/DESIGN.md §8), read by Cloudflare Pages. Checked by scripts/check-headers.mjs
# against the local preview, wrangler pages dev, the Pages preview and production. Pages applies every
# matching rule in order: a rule's `! Name` lines remove a header set by an earlier rule, then its own
# lines set it again (so the homepage replaces the card's CSP and drops its noindex).
/*
  ! Access-Control-Allow-Origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src https://api.apple-cloudkit.com; font-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; manifest-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'

# Pages joins a header that two matching rules set, so each Cache-Control has its own paths.
# The homepage, /press, /help, /privacy, /terms and their Spanish twins under /es/: no script at all,
# same-origin styles, fonts, images and media, nothing fetched (connect-src 'none'), indexable.
/
  ! Content-Security-Policy
  ! X-Robots-Tag
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; manifest-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  Cache-Control: no-cache

/press
