---
// One Help, Privacy or Terms page (my-pets-page issues 9 and 11): the copied text from content/legal/,
// rendered by Astro's Markdown at build time with its placeholders filled, a link to the same page in the
// other language, and the site's header and footer. No script.
import Base from '../layouts/Base.astro';
import { fillLegal, LEGAL, legalPath, SWITCH, type Lang, type LegalPage } from '../content/legal';

interface Props {
  lang: Lang;
  page: LegalPage;
  /** The Markdown file's HTML (its compiledContent()). */
  html: string;
}

const { lang, page, html } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const meta = LEGAL[lang][page];
const path = legalPath(page, lang);
const alternates = (['en', 'es'] as const).map((l) => ({ lang: l, path: legalPath(page, l) }));
---

<Base title={meta.title} description={meta.description} path={path} current={page} lang={lang} alternates={alternates}>
  <div class="wrap legal">
    <p class="legal__switch">
      <span class="sr-only">{SWITCH[lang].label}: </span>
      <a href={legalPath(page, other)} hreflang={other} lang={other}>{SWITCH[lang].text}</a>
    </p>
    <article class="legal__body">
      <Fragment set:html={fillLegal(html, lang)} />
    </article>
  </div>
</Base>

<style>
  .legal {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) calc(var(--spacing-section) / 2);
  }
  .legal__switch {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }
  .legal__switch a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .legal__body {
    max-width: 42rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .legal__body :global(h1) {
    margin: 0 0 1.5rem;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 620;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .legal__body :global(h2) {
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.2;
    font-weight: 620;
    letter-spacing: -0.02em;
  }
  .legal__body :global(p),
  .legal__body :global(ul) {
    margin: 0 0 1rem;
  }
  .legal__body :global(ul) {
    padding-left: 1.25rem;
  }
  .legal__body :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal__body :global(strong) {
    font-weight: 620;
  }
  .legal__body :global(h1 + p) {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
</style>
