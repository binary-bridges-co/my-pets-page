---
import { PRIVACY, SITE } from '../content/en';

interface Props {
  /** The site's privacy line (sitePrivacyLine), when the page does not show it in its own section. */
  privacyLine?: string;
}
const { privacyLine } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__by">{SITE.footerLine}</p>
    {
      privacyLine && (
        <p class="site-footer__privacy">
          {PRIVACY.site} <span id="site-privacy">{privacyLine}</span>
        </p>
      )
    }
    <ul class="site-footer__links">
      <li><a href="/">{SITE.footerHome}</a></li>
      <li><a href="/press">{SITE.footerPress}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: 2.5rem 3rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .site-footer__inner {
    display: grid;
    gap: 1rem;
  }
  .site-footer p {
    margin: 0;
    max-width: 38rem;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .site-footer__privacy {
      grid-column: 1;
    }
    .site-footer__links {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
